# Copy values into your shell environment; Spring does not automatically load .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mobile_user_springboot_dev
DB_USER=mobile_user_springboot
DB_PASSWORD=replace-with-a-local-password
APP_URL=http://localhost:8087
PORT=8087
SERVER_ADDRESS=127.0.0.1
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENABLED=true
MAIL_FROM=no-reply@mobileuser.test
SESSION_COOKIE_SECURE=false
FORWARD_HEADERS_STRATEGY=none
# Optional Shippo test integration. Empty key uses clearly marked demo delivery rates.
SHIPPO_API_KEY=
# JSON sender address: name, street1, city, state, zip, country (US), phone, email.
SHIPPO_ORIGIN_JSON=
# Set for tests only, pointing at a separately created test database:
TEST_DB_NAME=mobile_user_springboot_test
